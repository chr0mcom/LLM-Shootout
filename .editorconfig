root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_naming_rule.private_static_fields_pascal.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_pascal.style = pascal_case
dotnet_naming_rule.private_static_fields_pascal.severity = warning
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Unused usings are a build warning (and an error, because warnings are errors).
dotnet_diagnostic.IDE0005.severity = warning
# CA1062 (validate public arguments): public entry points validate with ArgumentNullException.ThrowIfNull where a null would
# be a caller bug; the rule would ask for it on every private-ish public method of internal services as well.
dotnet_diagnostic.CA1062.severity = none
# CA1708 reports a false positive for two `extension` blocks in one class (C# 14), see docs/dev/dotnet-baseline.md.
dotnet_diagnostic.CA1708.severity = none
# CA1812 (internal class never instantiated): services and records are created by dependency injection or by serializers.
dotnet_diagnostic.CA1812.severity = none
# CA1861 (constant arrays as static fields): readability of short literal arrays in prompts and tests matters more.
dotnet_diagnostic.CA1861.severity = none

[tests/**.cs]
# CA1707: test names are sentences with underscores.
dotnet_diagnostic.CA1707.severity = none

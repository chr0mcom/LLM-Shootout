# Settings of the Docker deployment (docker-compose.yml). Copy to `.env`, which is not versioned.

# Host name Traefik routes to the web interface (required).
SHOOTOUT_HOST=shootout.example.org

# Optional, shown with their defaults:
# SHOOTOUT_TRAEFIK_NETWORK=proxy
# SHOOTOUT_ENTRYPOINT=websecure
# SHOOTOUT_CERT_RESOLVER=letsencrypt
# Comma-separated Traefik middlewares, for example security headers: SHOOTOUT_MIDDLEWARES=secure-headers@file
# SHOOTOUT_MIDDLEWARES=

# Gateway endpoints `claude` and `codex` (docker-compose.gateway.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.gateway.yml
# SHOOTOUT_GATEWAY_URL=http://gateway:8090/v1

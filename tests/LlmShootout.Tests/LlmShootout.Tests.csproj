<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- IDE0005 (unused usings) is only reported in a build when the documentation file is generated; tests need no XML docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LlmShootout.Arena\LlmShootout.Arena.csproj" />
    <ProjectReference Include="..\..\src\LlmShootout.Games\LlmShootout.Games.csproj" />
    <ProjectReference Include="..\..\src\LlmShootout.Cli\LlmShootout.Cli.csproj" />
    <ProjectReference Include="..\..\src\LlmShootout.Web\LlmShootout.Web.csproj" />
  </ItemGroup>
</Project>
